# Copy to .env.local and fill in. Never commit .env.local.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never put this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail sending (preferred for now): Google Account -> Security -> 2-Step Verification on -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Test mode: every email (salon and customer) goes to this one inbox
EMAIL_REDIRECT_TO=

# Resend -> API Keys (alternative to Gmail)
RESEND_API_KEY=
# Use an address on a domain verified in Resend to email customers.
# Left empty, Resend's test sender is used and only the salon is emailed.
BOOKING_FROM_EMAIL=
# Fallback for booking alerts if none is set in the dashboard (Hours & settings)
SALON_NOTIFY_EMAIL=

# Public address of the site, used in email links
NEXT_PUBLIC_SITE_URL=https://level-up-hair-salon.vercel.app
